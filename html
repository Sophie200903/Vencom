<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vencom - Sistema de Ventas</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header class="header">
            <div class="header-left">
                <div class="logo">VENCOM</div>
                <input type="text" class="search-bar" placeholder="Buscar productos..." id="searchInput">
            </div>
            <div class="header-right">
                <button class="header-btn" id="cartBtn">
                    Carrito <span class="cart-counter" id="cartCounter">0</span>
                </button>
                <button class="header-btn">Mi Cuenta</button>
                <button class="header-btn">Salir</button>
            </div>
        </header>

        <!-- Main Layout -->
        <div class="main-layout">
            <!-- Sidebar -->
            <aside class="sidebar">
                <h3>Categorías</h3>
                <ul class="sidebar-menu" id="categoriesMenu">
                    <li><a data-category="todos" class="active">Todos los productos</a></li>
                    <li><a data-category="telefonos">Teléfonos</a></li>
                    <li><a data-category="computadoras">Computadoras</a></li>
                    <li><a data-category="audio">Audio y Video</a></li>
                    <li><a data-category="electronicos">TV y Electrónicos</a></li>
                    <li><a data-category="camaras">Cámaras</a></li>
                    <li><a data-category="tablets">Tablets</a></li>
                    <li><a data-category="deportes">Deportes</a></li>
                    <li><a data-category="hogar">Hogar</a></li>
                    <li><a data-category="gaming">Gaming</a></li>
                    <li><a data-category="moda">Moda</a></li>
                    <li><a data-category="libros">Libros</a></li>
                </ul>

                <h3 style="margin-top: 30px;">Filtros</h3>
                <ul class="sidebar-menu">
                    <li><a data-filter="precio-asc">Precio: Menor a Mayor</a></li>
                    <li><a data-filter="precio-desc">Precio: Mayor a Menor</a></li>
                    <li><a data-filter="nombre">Nombre A-Z</a></li>
                    <li><a data-filter="nuevos">Productos Nuevos</a></li>
                    <li><a data-filter="ofertas">Ofertas Especiales</a></li>
                    <li><a data-filter="mejor-valorados">Mejor Valorados</a></li>
                </ul>
            </aside>

            <!-- Content -->
            <main class="content">
                <div class="content-header">
                    <h1 class="content-title" id="pageTitle">Productos Destacados</h1>
                    <div class="breadcrumb">Inicio > Catálogo > <span id="current-category">Productos Destacados</span></div>
                </div>

                <div class="filter-bar">
                    <div class="results-count" id="resultsCount">Mostrando 0 productos</div>
                    <select class="sort-select" id="sortSelect">
                        <option value="">Ordenar por</option>
                        <option value="precio-asc">Precio: Menor a Mayor</option>
                        <option value="precio-desc">Precio: Mayor a Menor</option>
                        <option value="nombre">Nombre A-Z</option>
                        <option value="rating">Mejor valorados</option>
                    </select>
                </div>

                <!-- Success Message -->
                <div id="successMessage" class="success-message" style="display: none;"></div>

                <!-- Products Grid -->
                <div class="products-grid" id="products-grid">
                    <!-- Los productos se cargarán aquí dinámicamente -->
                </div>

                <!-- Pagination -->
                <div class="pagination">
                    <button onclick="changePage('prev')">« Anterior</button>
                    <button class="active" onclick="changePage(1)">1</button>
                    <button onclick="changePage(2)">2</button>
                    <button onclick="changePage(3)">3</button>
                    <button onclick="changePage('next')">Siguiente »</button>
                </div>
            </main>
        </div>

        <!-- Footer -->
        <footer class="footer">
            <div class="footer-content">
                <div class="footer-section">
                    <h4>Acerca de Vencom</h4>
                    <p>Somos la plataforma líder en comercio electrónico, ofreciendo los mejores productos con la mejor calidad y servicio al cliente excepcional.</p>
                </div>
                <div class="footer-section">
                    <h4>Servicio al Cliente</h4>
                    <ul>
                        <li>Centro de ayuda</li>
                        <li>Política de devoluciones</li>
                        <li>Términos y condiciones</li>
                        <li>Política de privacidad</li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Contacto</h4>
                    <p>Teléfono: (01) 234-5678<br>
                    Email: info@vencom.com<br>
                    Dirección: Calle 123 #45-67<br>
                    Bogotá, Colombia</p>
                </div>
            </div>
        </footer>
    </div>

    <!-- Modal para Comprar -->
    <div id="buyModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">Finalizar Compra</h2>
                <span class="close" onclick="closeBuyModal()">&times;</span>
            </div>
            <div class="modal-body">
                <div id="modal-buy-icon" class="modal-product-icon"></div>
                <h3 id="modal-buy-name" style="margin-bottom: 10px;"></h3>
                <div id="modal-buy-price" class="modal-product-price"></div>
                
                <div class="quantity-selector">
                    <label style="font-weight: bold;">Cantidad:</label>
                    <button class="quantity-btn" onclick="changeQuantity(-1)">-</button>
                    <input type="number" id="quantity" class="quantity-input" value="1" min="1">
                    <button class="quantity-btn" onclick="changeQuantity(1)">+</button>
                </div>
                
                <div class="total-price" id="total-price">Total: $0</div>

                <form id="purchaseForm">
                    <div class="form-group">
                        <label class="form-label">Email:</label>
                        <input type="email" class="form-control" id="email" required placeholder="tu@email.com">
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Nombre:</label>
                            <input type="text" class="form-control" id="nombre" required placeholder="Tu nombre">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Teléfono:</label>
                            <input type="tel" class="form-control" id="telefono" required placeholder="300 123 4567">
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Dirección:</label>
                        <input type="text" class="form-control" id="direccion" required placeholder="Calle 123 #45-67">
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Ciudad:</label>
                            <select class="form-control" id="ciudad" required>
                                <option value="">Seleccionar ciudad</option>
                                <option value="bogota">Bogotá</option>
                                <option value="medellin">Medellín</option>
                                <option value="cali">Cali</option>
                                <option value="barranquilla">Barranquilla</option>
                                <option value="cartagena">Cartagena</option>
                                <option value="bucaramanga">Bucaramanga</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Código Postal:</label>
                            <input type="text" class="form-control" id="codigoPostal" required placeholder="110111">
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Método de Pago:</label>
                        <select class="form-control" id="metodoPago" required>
                            <option value="">Seleccionar método</option>
                            <option value="tarjeta">Tarjeta de Crédito/Débito</option>
                            <option value="pse">PSE</option>
                            <option value="efecty">Efecty</option>
                            <option value="contraentrega">Contra Entrega</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Comentarios adicionales:</label>
                        <textarea class="form-control" id="comentarios" rows="3" placeholder="Instrucciones especiales para la entrega..."></textarea>
                    </div>
                </form>

                <div class="modal-actions">
                    <button class="btn-modal btn-modal-primary" onclick="processPurchase()">Confirmar Pedido</button>
                    <button class="btn-modal btn-modal-secondary" onclick="closeBuyModal()">Cancelar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para Ver Detalles -->
    <div id="detailModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">Detalles del Producto</h2>
                <span class="close" onclick="closeDetailModal()">&times;</span>
            </div>
            <div class="modal-body">
                <div id="modal-detail-icon" class="modal-product-icon"></div>
                <h3 id="modal-detail-name"></h3>
                <div id="modal-detail-price" class="modal-product-price"></div>
                <div class="product-rating" id="modal-detail-rating">
                    <div class="stars">★★★★★</div>
                    <span class="rating-text">(4.5/5 - 128 reseñas)</span>
                </div>
                <div id="modal-detail-description" class="modal-product-description"></div>
                
                <div class="product-details">
                    <h4 style="color: #2c3e50; margin-bottom: 15px;">Especificaciones Técnicas</h4>
                    <div id="product-specs"></div>
                </div>

                <div class="product-features" style="margin-top: 20px;">
                    <h4 style="color: #2c3e50; margin-bottom: 15px;">Características Destacadas</h4>
                    <div id="product-features"></div>
                </div>

                <div class="modal-actions">
                    <button class="btn-modal btn-modal-primary" onclick="openBuyModalFromDetail()">Comprar Ahora</button>
                    <button class="btn-modal btn-modal-secondary" onclick="closeDetailModal()">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de Carrito -->
    <div id="cartModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">Carrito de Compras</h2>
                <span class="close" onclick="closeCartModal()">&times;</span>
            </div>
            <div class="modal-body">
                <div id="cart-items"></div>
                <div class="cart-total" id="cart-total">
                    <strong>Total: $0</strong>
                </div>
                <div class="modal-actions" style="margin-top: 20px;">
                    <button class="btn-modal btn-modal-primary" onclick="proceedToCheckout()">Proceder al Pago</button>
                    <button class="btn-modal btn-modal-secondary" onclick="clearCart()">Vaciar Carrito</button>
                </div>
            </div>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
